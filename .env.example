# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salonflow?schema=public"

# Separate database used by the integration test suite (it is wiped on every run)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salonflow_test?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL of the app (used in password-reset links)
APP_URL="http://localhost:3000"

# Where uploaded expense receipts are stored (outside /public, served through an authenticated route)
RECEIPTS_DIR="./storage/receipts"
