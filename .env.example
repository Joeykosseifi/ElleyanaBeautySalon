# PostgreSQL connection string — replace USER and PASSWORD with your database login
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salonflow?schema=public"

# Separate database for the integration tests — its data is deleted on every run, so never point it at real data
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salonflow_test?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL of the app (used in password-reset links)
APP_URL="http://localhost:3000"

# Where uploaded expense receipts are stored (outside /public, served through an authenticated route)
RECEIPTS_DIR="./storage/receipts"

# First-run owner account, created by `npm run db:seed`. Only the salon and this
# login are created — no demo data. Use your real email and a strong password,
# and keep them out of source control (this file is a template only).
# SALON_OWNER_PASSWORD is only needed the first time; once the owner exists you
# can delete it — re-running db:seed then simply reports "already exists".
SALON_OWNER_NAME="Elleyana"
SALON_OWNER_EMAIL="owner@example.com"
SALON_OWNER_PASSWORD="change-me-to-a-strong-password"
# Optional overrides
# SALON_NAME="Elleyana Beauty Salon"
# SALON_TIMEZONE="Asia/Beirut"
