# PostgreSQL connection string — replace USER and PASSWORD with your database login
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salonflow?schema=public"

# Separate database for the integration tests — its data is deleted on every run, so never point it at real data
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salonflow_test?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL of the app (used in password-reset links)
APP_URL="http://localhost:3000"

# Where uploaded expense receipts are stored (outside /public, served through an authenticated route)
RECEIPTS_DIR="./storage/receipts"

# There are no owner credentials here: on a brand-new database SalonFlow opens a
# one-time "Create owner account" screen, and the owner chooses their own email and
# password in the browser. They are stored only in PostgreSQL (password bcrypt-hashed).

# One-time secret that authorises that first-run screen, so nobody else can claim a
# freshly deployed instance. It is NOT the owner's password. Generate a fresh one with
#   openssl rand -base64 32
# (at least 24 characters), enter it on the setup screen, then DELETE this line once
# the owner account exists. Leave it empty and setup stays locked.
SALON_SETUP_TOKEN=""
